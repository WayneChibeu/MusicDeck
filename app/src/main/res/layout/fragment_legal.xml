<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glassmorphic"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_info_outline"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms of Use &amp; Privacy Policy"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusicDeck Terms of Service &amp; Privacy Policy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. No Hosting &amp; Copyright Disclaimer (DMCA)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusicDeck is purely a local audio playback engine and metadata aggregator. The developers and creators of MusicDeck do not host, distribute, store, or pirate any copyrighted audio files on any servers. All audio files played through MusicDeck are strictly provided by the end-user. MusicDeck is not liable for any copyright infringement committed by the user."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Personal Use Only"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This application is provided strictly for personal, non-commercial use. Users may not use MusicDeck to publicly broadcast, sell, or distribute copyrighted material. Furthermore, you are expressly prohibited from cloning, copying, or redistributing the MusicDeck application itself for commercial purposes or financial gain."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Privacy &amp; Data Collection"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your privacy is our utmost priority. MusicDeck operates with a strict 'local-first' architecture.\n\n• Zero Tracking: We do not collect, monitor, track, sell, or monetize your personal data, device identifiers, or playback history.\n• Local Device Storage: All user-generated content (listening history, custom covers, playlists, preferences) remains strictly stored on your local device.\n• Network Usage: Network connectivity is used exclusively for fetching public song metadata and synchronized lyrics (via LRCLIB) and checking for application releases via GitHub."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp" />

            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Automatic Update Checks"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusicDeck incorporates an automated update checker that queries the public GitHub Releases API to notify you of new features and security fixes. During this check:\n\n• No personally identifiable information (PII) or device fingerprint is sent.\n• The application only compares the remote release tag with the installed version.\n• When downloading updates, the APK file is transferred securely directly from official GitHub release assets into your device's application directory."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp" />

            <!-- Section 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Audio Processing &amp; Sound Engine"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All audio enhancements—including the Equalizer, Bass Boost, Loudness Gain Booster, and 3D Spatial Virtualizer—are processed entirely on-device in real-time utilizing the Android hardware DSP pipeline. No audio streams are recorded, intercepted, or transmitted over any network."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp" />

            <!-- Section 6 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. As-Is Warranty"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusicDeck is provided 'as is' without warranties of any kind, express or implied. The developers are not liable for data loss, device issues, or consequences arising from the use of this software."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="40dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
