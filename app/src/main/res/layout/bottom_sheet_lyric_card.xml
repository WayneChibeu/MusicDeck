<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glassmorphic"
    android:padding="20dp"
    android:maxHeight="600dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_palette"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="10dp"
            android:contentDescription="Card palette" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shareable Lyric Card"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvSelectionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select up to 5 lines to feature"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Theme Selection Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupThemes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThemeViolet"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violet"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThemeMidnight"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Midnight" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThemeRose"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rose" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThemeCyan"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cyan" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- Lyric Lines Selection List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCardLyrics"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:padding="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Share Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareLyricCard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Export &amp; Share Card"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_share"
        app:iconGravity="textStart"
        app:cornerRadius="16dp" />

</LinearLayout>
