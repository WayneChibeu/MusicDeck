<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@drawable/bg_bottom_sheet_glassmorphic">

    <LinearLayout
        android:id="@+id/eqRootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle"/>

        <!-- Header: Title, Reset Button, Master Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Equalizer"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvEqStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customized Soundstage"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Reset Button -->
            <ImageView
                android:id="@+id/btnResetEq"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:background="@drawable/bg_glassmorphic_item"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Reset Equalizer" />

            <!-- Master EQ Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Presets Horizontal Carousel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESETS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:id="@+id/scrollPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/presetChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- 5-Band EQ Board Container -->
        <LinearLayout
            android:id="@+id/eqBandsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eq_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Bands Header & dB Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Graphic Equalizer"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±15 dB"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- 5 Channel Columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Band 1 (60 Hz) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_eq_channel"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGainBand1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SeekBar
                            android:id="@+id/seekBand1"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/colorPrimary"
                            android:thumbTint="?attr/colorPrimary"
                            android:splitTrack="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelBand1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 Hz"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Band 2 (230 Hz) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_eq_channel"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGainBand2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SeekBar
                            android:id="@+id/seekBand2"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/colorPrimary"
                            android:thumbTint="?attr/colorPrimary"
                            android:splitTrack="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelBand2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="230 Hz"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Band 3 (910 Hz) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_eq_channel"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGainBand3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SeekBar
                            android:id="@+id/seekBand3"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/colorPrimary"
                            android:thumbTint="?attr/colorPrimary"
                            android:splitTrack="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelBand3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="910 Hz"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Band 4 (3.6 kHz) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_eq_channel"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGainBand4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SeekBar
                            android:id="@+id/seekBand4"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/colorPrimary"
                            android:thumbTint="?attr/colorPrimary"
                            android:splitTrack="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelBand4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.6 kHz"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Band 5 (14 kHz) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_eq_channel"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGainBand5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SeekBar
                            android:id="@+id/seekBand5"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/colorPrimary"
                            android:thumbTint="?attr/colorPrimary"
                            android:splitTrack="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelBand5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 kHz"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bass Boost Module Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eq_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_headset"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bass Boost"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvBassBoostLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/bg_glassmorphic_item"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBassBoost"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Volume Booster Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eq_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volume Booster"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amplifies quiet audio without clipping"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.7" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVolumeBoostLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0 dB"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/bg_glassmorphic_item"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekVolumeBoost"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1200"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- 3D Spatial Audio (Virtualizer) Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eq_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_surround_sound"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3D Spatial Audio"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulates studio width &amp; soundstage depth"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.7" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVirtualizerLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/bg_glassmorphic_item"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekVirtualizer"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Extreme Bass Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_eq_extreme_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extreme Bass Mode"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorError" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overrides hardware thresholds for intense sub-bass resonance."
                    android:textSize="11sp"
                    android:textColor="?attr/colorError"
                    android:alpha="0.8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchExtremeBass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="?attr/colorError"
                android:trackTint="?attr/colorError" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
