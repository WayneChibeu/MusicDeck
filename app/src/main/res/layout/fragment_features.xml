<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glassmorphic"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feature Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Insights -->
    <LinearLayout
        android:id="@+id/menuInsights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_insert_chart"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening Insights"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track play history and streaks"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Smart Playlists -->
    <LinearLayout
        android:id="@+id/menuSmartPlaylists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_auto_fix"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Playlists"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-generate mood playlists"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSmartPlaylists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Playlist Collage -->
    <LinearLayout
        android:id="@+id/menuPlaylistCollage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cover Collages"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show 2x2 grid for playlist covers"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPlaylistCollage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Song Notes -->
    <LinearLayout
        android:id="@+id/menuSongNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Notes"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add personal annotations to songs"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSongNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Shake to Shuffle -->
    <LinearLayout
        android:id="@+id/menuShakeShuffle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shuffle_on"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shake to Shuffle"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shake phone to randomize playback queue"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchShakeShuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Earbud Smart Combo Shuffle -->
    <LinearLayout
        android:id="@+id/menuEarbudShuffle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_headset"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earbud Smart Shuffle"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Double-tap Next on earphones to shuffle"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEarbudShuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Pulsating Album Art -->
    <LinearLayout
        android:id="@+id/menuAlbumPulsing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glassmorphic_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_album"
            app:tint="?attr/colorPrimary" />
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pulsating Album Art"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtle rhythmic breathing animation"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlbumPulsing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>
