<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- LYRICS DIMMER: Smoothly darkens the background when reading lyrics -->
    <View
        android:id="@+id/lyricsDimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0" />

    <!-- COVER VIEW - Main player layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/coverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:paddingTop="72dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="visible">

        <!-- Album Art Container with Gestures & Overlays -->
        <FrameLayout
            android:id="@+id/artContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvFullTitle"
            app:layout_constraintVertical_chainStyle="packed"
            android:elevation="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFullArtIncoming"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                android:src="@drawable/default_album_art"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFullArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album_art"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

            <!-- Left Seek (-5s) Minimal Arc + Typography Overlay -->
            <FrameLayout
                android:id="@+id/layoutSeekRewind"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="36dp"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivSeekRewindIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_seek_arc_rewind" />

                <TextView
                    android:id="@+id/tvSeekRewindNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Right Seek (+5s) Minimal Arc + Typography Overlay -->
            <FrameLayout
                android:id="@+id/layoutSeekForward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="36dp"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivSeekForwardIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_seek_arc_forward" />

                <TextView
                    android:id="@+id/tvSeekForwardNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Right-Side Vertical Volume Capsule HUD (Control Center Style) -->
            <FrameLayout
                android:id="@+id/layoutVolumeHud"
                android:layout_width="36dp"
                android:layout_height="140dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_volume_capsule_track"
                android:clipToOutline="true"
                android:alpha="0"
                android:visibility="gone">

                <!-- Dynamic Bottom-to-Top Fill -->
                <View
                    android:id="@+id/vVolumeCapsuleFill"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_volume_capsule_fill" />

                <!-- Volume Percent at Top -->
                <TextView
                    android:id="@+id/tvVolumeHudPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="50%"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Volume Speaker Icon at Bottom -->
                <ImageView
                    android:id="@+id/ivVolumeHudIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="#DD111115" />
            </FrameLayout>

            <!-- High Volume Warning Pill (automated, non-blocking) -->
            <TextView
                android:id="@+id/tvVolumeWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="High Volume"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/bg_volume_warning_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:elevation="10dp"
                android:visibility="gone"
                android:alpha="0" />
        </FrameLayout>

        <!-- Title + Favorite -->
        <TextView
            android:id="@+id/tvFullTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Song Title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@+id/artContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnFavorite"
            app:layout_constraintBottom_toTopOf="@+id/tvFullArtist"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:src="@drawable/ic_favorite_border"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintTop_toTopOf="@+id/tvFullTitle"
            app:layout_constraintBottom_toBottomOf="@+id/tvFullTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Artist -->
        <TextView
            android:id="@+id/tvFullArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Artist Name"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.8"
            android:singleLine="true"
            app:layout_constraintTop_toBottomOf="@+id/tvFullTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvCurrentTime" />

        <!-- INLINE SEEK BAR LAYOUT -->
        
        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/seekBar"
            app:layout_constraintBottom_toBottomOf="@+id/seekBar" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="8dp"
            android:max="1000"
            android:progress="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb"
            android:progressDrawable="@drawable/seek_progress"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:paddingVertical="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvFullArtist"
            app:layout_constraintStart_toEndOf="@+id/tvCurrentTime"
            app:layout_constraintEnd_toStartOf="@+id/tvTotalTime" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/seekBar"
            app:layout_constraintBottom_toBottomOf="@+id/seekBar" />

        <!-- Controls -->
        <LinearLayout
            android:id="@+id/layoutControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/seekBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_repeat_off"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Repeat" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev_rounded"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Previous" />

            <FrameLayout
                android:id="@+id/playPauseContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_play_button_ring">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_play_rounded"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="Play/Pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next_rounded"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Next" />

            <ImageButton
                android:id="@+id/btnQueue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_queue"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Queue" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LYRIC VIEW -->
    <FrameLayout
        android:id="@+id/lyricView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="72dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Inner Lyrics Vertical Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Loading Indicator -->
        <LinearLayout
            android:id="@+id/lyricsLoadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="?attr/colorSecondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fetching lyrics..."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.7" />
        </LinearLayout>

        <!-- No Lyric Placeholder -->
        <LinearLayout
            android:id="@+id/noLyricPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Lyric Yet"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="or"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManuallySpecifyLyric"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Manually specify lyric file"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Lyrics RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="160dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        </LinearLayout>

        <!-- Scrubber Timestamp -->
        <LinearLayout
            android:id="@+id/scrollTimestampContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:alpha="0"
            android:visibility="gone">
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_rounded_12"
                android:backgroundTint="?attr/colorOnSurfaceVariant"
                android:alpha="0.2"/>
            <TextView
                android:id="@+id/tvScrollTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Floating Desktop Lyric Toggle -->
        <ImageButton
            android:id="@+id/btnDesktopLyrics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_music_note"
            app:tint="?attr/colorOnSurfaceVariant"
            android:alpha="0.7" />

    </FrameLayout>

    <!-- HEADER (Always on top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@drawable/bg_player_header_scrim"
        android:paddingHorizontal="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Collapse"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Toggle Container with single stroke around entire pill -->
        <FrameLayout
            android:id="@+id/toggleWrapper"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_toggle_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            
            <LinearLayout
                android:id="@+id/toggleContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCover"
                    style="@style/Widget.App.ToggleButton.Left"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="72dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="COVER"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLyric"
                    style="@style/Widget.App.ToggleButton.Right"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="72dp"
                    android:checkable="true"
                    android:text="LYRIC"
                    android:textSize="11sp" />

            </LinearLayout>
            
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
