<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerThemeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <!-- Swatch Container with Ring Overlay -->
    <FrameLayout
        android:id="@+id/swatchContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal">

        <!-- Outer Selected Ring -->
        <View
            android:id="@+id/viewSelectedRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#40FFFFFF"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Color Circle Swatch -->
        <View
            android:id="@+id/viewColorCircle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_color_circle" />

        <!-- Selected Checkmark Icon -->
        <ImageView
            android:id="@+id/ivSelectedCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="@android:color/white"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Color Name -->
    <TextView
        android:id="@+id/tvThemeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#CCFFFFFF"
        tools:text="Vibrant Violet" />

</LinearLayout>
