<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/carModeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:padding="16dp">

    <!-- LEFT PANE: Balanced 1:1 Album Artwork Display (28% width) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCarAlbumArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#1A1A1E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintWidth_percent="0.28"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivCarAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@drawable/default_album_art" />
    </androidx.cardview.widget.CardView>

    <!-- RIGHT PANE: Controls, Track Info, Progress, Quick Access -->

    <!-- Top Header Bar: Exit Button, Title/Badge, Voice Search -->
    <ImageButton
        android:id="@+id/btnExitCarMode"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Exit Car Mode"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFFFF"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/headerCarMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/btnExitCarMode"
        app:layout_constraintStart_toEndOf="@+id/btnExitCarMode"
        app:layout_constraintTop_toTopOf="@+id/btnExitCarMode">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="CAR MODE"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCarStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="• Screen Awake"
            android:textColor="#80FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCarVoiceSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voice Search"
        android:padding="12dp"
        android:src="@drawable/ic_search"
        app:tint="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Track Title (Oversized, High-Contrast) -->
    <TextView
        android:id="@+id/tvCarTrackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:ellipsize="marquee"
        android:gravity="start"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="Select a song to play"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt"
        app:layout_constraintTop_toBottomOf="@+id/btnExitCarMode" />

    <!-- Artist & Album Subtitle -->
    <TextView
        android:id="@+id/tvCarTrackArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:text="MusicDeck Audio Engine"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt"
        app:layout_constraintTop_toBottomOf="@+id/tvCarTrackTitle" />

    <!-- Progress Bar & Timers -->
    <LinearLayout
        android:id="@+id/carProgressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt"
        app:layout_constraintTop_toBottomOf="@+id/tvCarTrackArtist">

        <TextView
            android:id="@+id/tvCarCurrentTime"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbCarProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressDrawable="@drawable/seek_progress_primary"
            android:thumb="@drawable/seek_thumb_primary" />

        <TextView
            android:id="@+id/tvCarTotalTime"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Driving Controls: Prev, Rewind 10s, Play/Pause, Forward 10s, Next -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/bottomUtilityContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt"
        app:layout_constraintTop_toBottomOf="@+id/carProgressContainer">

        <!-- Previous Track Button (56dp) -->
        <ImageButton
            android:id="@+id/btnCarPrevious"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Track"
            android:padding="12dp"
            android:src="@drawable/ic_prev_rounded"
            app:tint="#FFFFFFFF" />

        <!-- Rewind 10s Button (48dp) -->
        <ImageButton
            android:id="@+id/btnCarRewind10"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rewind 10 Seconds"
            android:padding="11dp"
            android:src="@drawable/ic_seek_rewind_10"
            app:tint="#FFFFFFFF" />

        <!-- Play / Pause Hero Button (76dp) -->
        <FrameLayout
            android:id="@+id/btnCarPlayPause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_btn_circle_primary"
            android:clickable="true"
            android:contentDescription="Play or Pause"
            android:elevation="6dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCarPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Play/Pause Icon"
                android:src="@drawable/ic_play_rounded"
                app:tint="#FF000000" />
        </FrameLayout>

        <!-- Forward 10s Button (48dp) -->
        <ImageButton
            android:id="@+id/btnCarForward10"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward 10 Seconds"
            android:padding="11dp"
            android:src="@drawable/ic_seek_forward_10"
            app:tint="#FFFFFFFF" />

        <!-- Next Track Button (56dp) -->
        <ImageButton
            android:id="@+id/btnCarNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Track"
            android:padding="12dp"
            android:src="@drawable/ic_next_rounded"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

    <!-- Bottom Secondary Controls: Shuffle, Favorite (Like), Repeat, Favorites Playlist (Centered, Zero Scroll) -->
    <LinearLayout
        android:id="@+id/bottomUtilityContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCarAlbumArt">

        <!-- Shuffle Button (Solid Fill Style, 48dp) -->
        <ImageButton
            android:id="@+id/btnCarShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_circle_surface"
            android:contentDescription="Shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle_off"
            app:tint="#FFFFFFFF" />

        <!-- Favorite / Like Track Button (Solid Heart, 48dp) -->
        <ImageButton
            android:id="@+id/btnCarFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_circle_surface"
            android:contentDescription="Favorite Track"
            android:padding="12dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="#FFFFFFFF" />

        <!-- Repeat Button (Solid Fill Style, 48dp) -->
        <ImageButton
            android:id="@+id/btnCarRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_circle_surface"
            android:contentDescription="Repeat"
            android:padding="12dp"
            android:src="@drawable/ic_repeat_off"
            app:tint="#FFFFFFFF" />

        <!-- Sleek Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="12dp"
            android:background="#2E2E3C" />

        <!-- Favorites Playlist Chip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCarFavorites"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#1A1A22"
            android:text="Favorites"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="none"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="14dp"
            app:strokeColor="#2E2E3C"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_favorite"
            app:iconTint="@color/colorRose"
            app:iconSize="16dp"
            app:iconPadding="6dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
